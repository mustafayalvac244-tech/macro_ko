{
  "expo": {
    "name": "Araç Audit",
    "slug": "arac-audit",
    "owner": "olivyeejiru",
    "version": "0.2.1",
    "icon": "./assets/images/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b553b239-3636-4b29-9b4e-cc908e625b16",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "scheme": "aracaudit",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F1F4F7",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aracaudit.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aracaudit.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#173C7E"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Şasi barkodunu okutmak ve hata fotoğrafı çekmek için kamerayı kullanır.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Daha önce çektiğiniz hata fotoğraflarını denetime eklemek için galeriye erişir.",
          "cameraPermission": "Hata fotoğrafını doğrudan çekip denetime eklemek için kamerayı kullanır."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "b553b239-3636-4b29-9b4e-cc908e625b16"
      }
    }
  }
}
