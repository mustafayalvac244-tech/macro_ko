# Windows betikleri CRLF ile çıkmalı. LF satır sonlu bir .bat dosyasında
# cmd.exe `goto` hedeflerini bulamaz ve betik sessizce yarıda kalır — bu
# kullanıcıya "dosya açılmıyor" diye görünür.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Geri kalan her şey LF.
*.py   text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.ino  text eol=lf
*.h    text eol=lf
*.cpp  text eol=lf
