# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Apple App Store Connect API key (never commit)
asc-api-key.p8
*.p8

# iOS signing material (never commit)
ios-creds/
credentials.json
*.p12
*.mobileprovision
*.cer

# Built APKs (too large for git; distribute via EAS/direct link)
apk/

# Supabase CLI yerel çalışma dosyaları (bağlı proje bilgisi, sürüm önbelleği)
supabase/.temp/

# scripts/eval-cevap-hatalar.json BURADAN ÇIKARILDI. Diğer beş ölçümün sonucu
# (sohbet/künye/dilekçe/mütalaa/belge) dalda tutuluyor ki iki koşu
# karşılaştırılabilsin; yalnız cevap ölçümü yok sayılıyordu ve olcum.yml'nin
# "sonuçları dala işle" adımı onu sessizce atlıyordu — 2026-09-11 koşusunda
# 13 sorunun 2'si düştü ve düşen cevapların metni hiçbir yere kaydedilmedi.

# Web sürümü derleme çıktısı DEĞİL: docs/app yayınlanıyor (GitHub Pages),
# bilerek depoda tutuluyor. Buraya eklenmemeli.

# İSTİSNA — web sürümünün varlıkları. Expo web dışa aktarımı ikon fontlarını
# docs/app/assets/node_modules/... altına koyuyor ve yukarıdaki "node_modules/"
# kuralı bunları depoya HİÇ ALMIYORDU: dosyalar diskte vardı, yayında yoktu ve
# uygulama web'de İKONSUZ açılıyordu (42 font, hepsi 404). Sessiz bir arızaydı —
# sayfa açılıyor, sadece her ikonun yerinde boş kare çıkıyordu.
!docs/app/**

# Web dışa aktarımının GEÇİCİ veri kopyası. Kanun JSON'ları web'de JS paketine
# gömülmez, public/ üzerinden statik dosya olarak servis edilir; bu klasörü
# scripts/web-veri-hazirla.mjs her dışa aktarımdan önce yeniden üretir.
# Tek doğruluk kaynağı src/data/laws — kopya depoya girmez.
/public/veri/
