# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Apple App Store Connect API key (never commit)
asc-api-key.p8
*.p8

# iOS signing material (never commit)
ios-creds/
credentials.json
*.p12
*.mobileprovision
*.cer

# Built APKs (too large for git; distribute via EAS/direct link)
apk/

# Supabase CLI yerel çalışma dosyaları (bağlı proje bilgisi, sürüm önbelleği)
supabase/.temp/

# Ölçüm çıktısı (hatalı cevapların tam metni; koşuya özgü, sürümlenmez)
scripts/eval-cevap-hatalar.json

# Web sürümü derleme çıktısı DEĞİL: docs/app yayınlanıyor (GitHub Pages),
# bilerek depoda tutuluyor. Buraya eklenmemeli.

# İSTİSNA — web sürümünün varlıkları. Expo web dışa aktarımı ikon fontlarını
# docs/app/assets/node_modules/... altına koyuyor ve yukarıdaki "node_modules/"
# kuralı bunları depoya HİÇ ALMIYORDU: dosyalar diskte vardı, yayında yoktu ve
# uygulama web'de İKONSUZ açılıyordu (42 font, hepsi 404). Sessiz bir arızaydı —
# sayfa açılıyor, sadece her ikonun yerinde boş kare çıkıyordu.
!docs/app/**
